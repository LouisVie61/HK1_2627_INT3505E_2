{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CategoryCreate",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "slug": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-z0-9-]+$" }
  },
  "required": ["name", "slug"],
  "additionalProperties": false
}
